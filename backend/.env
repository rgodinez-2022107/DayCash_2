# Puerto del servidor
PORT=3000

# Clave secreta para firmar los JWT (CAMBIAR en producción por una cadena larga y aleatoria)
JWT_SECRET=change_this_super_secret_key_before_deploying
JWT_EXPIRES_IN=30m

# Credenciales del único usuario permitido en el sistema
ADMIN_EMAIL=admin@financeapp.com
ADMIN_PASSWORD=Admin123!

# Origen permitido para CORS (URL del frontend Angular)
CORS_ORIGIN=http://localhost:4200

# Conexión a PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=daycash_db
PGUSER=postgres
PGPASSWORD=admin

# Google OAuth (Cliente ID de Google Cloud Console)
GOOGLE_CLIENT_ID=1038077674652-olvukhfl4bd6gn9pgpc54t8j2l5ouo4t.apps.googleusercontent.com